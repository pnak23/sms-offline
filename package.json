{
  "name": "sms-offline",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Khmer primary school management system (Windows desktop)",
  "workspaces": [
    "frontend",
    "desktop"
  ],
  "engines": {
    "node": ">=22.22.3 || >=24.15.0"
  },
  "scripts": {
    "backend:test": "node scripts/run-mvn.mjs test",
    "backend:build": "node scripts/run-mvn.mjs package -DskipTests",
    "frontend:build": "npm run generate -w frontend",
    "smoke:backend": "node scripts/smoke-backend.mjs",
    "smoke:export": "node scripts/smoke-export.mjs",
    "reset-admin": "node scripts/reset-admin.mjs",
    "test:reset-admin": "node scripts/test-reset-admin.mjs",
    "test:desktop": "node --test desktop/test/config.test.mjs desktop/test/backups.test.mjs desktop/test/version.test.mjs desktop/test/windowSize.test.mjs desktop/test/khmerReview.test.mjs desktop/test/installerCleanup.test.mjs desktop/test/verifyScripts.test.mjs",
    "e2e:shell": "node desktop/test/e2e-shell.mjs",
    "e2e:packaged": "node desktop/test/e2e-packaged.mjs",
    "build:all": "node scripts/build-all.mjs",
    "build:all:dir": "node scripts/build-all.mjs --dir",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "e2e:app": "node desktop/test/e2e-app.mjs",
    "e2e:backup": "node desktop/test/e2e-backup.mjs",
    "e2e:changes": "node desktop/test/e2e-changes.mjs",
    "e2e:honor": "node desktop/test/e2e-honor.mjs",
    "e2e:ranking": "node desktop/test/e2e-ranking.mjs",
    "e2e:subjects": "node desktop/test/e2e-subjects.mjs",
    "e2e:lists": "node desktop/test/e2e-lists.mjs",
    "e2e:homework": "node desktop/test/e2e-homework.mjs",
    "e2e:timetable": "node desktop/test/e2e-timetable.mjs",
    "e2e:dashboard": "node desktop/test/e2e-dashboard.mjs",
    "khmer:review": "node scripts/khmer-review.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "e2e:killed": "node desktop/test/e2e-killed.mjs",
    "sample:seed": "node scripts/seed-sample-data.mjs",
    "sample:start": "node scripts/start-sample.mjs",
    "test:backup-flow": "node scripts/test-backup-flow.mjs",
    "test:nsis-cleanup": "node desktop/test/nsis-cleanup-selftest.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "check:pages": "node scripts/count-pages.mjs",
    "measure:presets": "node scripts/measure-presets.mjs",
    "e2e:ui": "npm run e2e -w frontend"
  }
}
