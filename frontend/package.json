    "test:watch": "vitest",
    "e2e": "node e2e/walkthrough.mjs"
  },
  "dependencies": {
    "@fontsource/battambang": "5.3.0",
    "@fontsource/moul": "5.3.0",
    "@fontsource/noto-sans-khmer": "5.3.0",
    "@fontsource/noto-serif-khmer": "5.3.0",
    "@iconify-json/bi": "1.2.7",
    "@iconify/vue": "5.0.4",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "1.0.3",
    "@vee-validate/zod": "4.15.1",
    "bootstrap": "5.3.8",
    "bootstrap-vue-next": "1.2.2",
    "dayjs": "1.11.23",
    "nuxt": "4.6.3",
    "pinia": "4.1.0",
    "vee-validate": "4.15.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
