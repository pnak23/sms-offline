{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nuxt 4 single-page UI (Khmer), served to Electron through the app:// protocol",
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p tests/tsconfig.json",
